generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum STATUS {
  PENDING
  PROCESSING
  COMPLETED
}

model Request {
  id        String   @id @default(uuid())
  type      String
  payload   Json 
  status    STATUS   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
